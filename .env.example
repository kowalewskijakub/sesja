# --- Baza danych (Neon) ---
# Connection string z panelu Neon (zakładka "Connection Details").
# Użyj wariantu "pooled" / z parametrem ?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/sesja?sslmode=require"

# --- Sekret do podpisywania sesji admina ---
# Wygeneruj np.: openssl rand -base64 32
ADMIN_JWT_SECRET="zmien-mnie-na-dlugi-losowy-ciag"

# --- E-mail (Resend) ---
# Klucz API z https://resend.com  (darmowy tier: 3000 maili / mc)
# Jeśli pole jest puste, kod logowania admina wypisze się w logach serwera (tryb dev).
RESEND_API_KEY=""
EMAIL_FROM="Sesja <noreply@twoja-domena.pl>"

# --- Embeddingi (OpenAI) ---
# Klucz z https://platform.openai.com  (model text-embedding-3-small, grosze za sesję)
# Jeśli pole jest puste, matchowanie działa w trybie awaryjnym (tylko identyczny tekst).
OPENAI_API_KEY=""

# Próg dopasowania pytań (cosine similarity 0-1). Wyżej = ostrzejsze dopasowanie.
MATCH_THRESHOLD="0.82"

# --- Adres aplikacji (do generowania linków do udostępniania) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
