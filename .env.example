# --- Baza danych (Neon) ---
# Connection string z panelu Neon (Dashboard -> Connection Details, wariant "pooled").
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/sesja?sslmode=require"

# --- Neon Auth (logowanie prowadzącego) ---
# Włącz Auth w projekcie Neon: Project -> Branch -> Auth -> Configuration.
# Skopiuj stamtąd Auth URL:
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.eu-central-1.aws.neon.tech/neondb/auth"
# Sekret do podpisywania ciasteczek sesji — MIN. 32 znaki.
# Wygeneruj: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="zmien-mnie-na-losowy-ciag-min-32-znaki"

# --- Embeddingi (OpenRouter) ---
# Klucz z https://openrouter.ai/settings/keys
# Jeśli puste — matchowanie działa w trybie awaryjnym (tylko identyczny tekst).
OPENROUTER_API_KEY=""

# Model embeddingów. Domyślny ma 1536 wymiarów (zgodny ze schematem bazy).
# Zmiana na model o innej liczbie wymiarów wymaga zmiany EMBEDDING_DIM
# w src/db/schema.ts i ponownej migracji bazy.
EMBEDDING_MODEL="openai/text-embedding-3-small"

# Próg dopasowania pytań (cosine similarity 0-1). Wyżej = ostrzejsze dopasowanie.
MATCH_THRESHOLD="0.82"

# --- Adres aplikacji (do generowania linków do udostępniania) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
